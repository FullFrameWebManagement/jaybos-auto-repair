---
const phone = '(207) 485-4421';
const phoneLink = 'tel:+12074854421';
const year = new Date().getFullYear();
---
<footer style="background-color:#0A0A0A; border-top:3px solid #E87722; color:#D1D5DB; padding:60px 0 32px;">
  <div class="container-wide">
    <div style="display:grid; grid-template-columns:repeat(auto-fit,minmax(220px,1fr)); gap:48px; margin-bottom:48px;">
      <div>
        <img src="/images/logo.png" alt="Jaybo's Auto Repair & Metal Fabrication" style="height:48px; width:auto; margin-bottom:16px;" />
        <p style="font-size:15px; line-height:1.6; color:#9CA3AF; margin-top:12px;">
          Auto repair, motorcycle repair, welding, and custom fabrication serving Winthrop, Monmouth, Manchester, and Readfield, Maine.
        </p>
      </div>
      <div>
        <h3 style="font-family:'Barlow Condensed',sans-serif; font-size:20px; font-weight:700; color:white; margin:0 0 16px; letter-spacing:0.04em;">Services</h3>
        <ul style="list-style:none; padding:0; margin:0; display:flex; flex-direction:column; gap:8px;">
          <li><a href="#services" style="color:#9CA3AF; font-size:15px;">Auto Repair</a></li>
          <li><a href="#motorcycle" style="color:#9CA3AF; font-size:15px;">Motorcycle Repair</a></li>
          <li><a href="#fabrication" style="color:#9CA3AF; font-size:15px;">Welding &amp; Fabrication</a></li>
          <li><a href="#skidsteer" style="color:#9CA3AF; font-size:15px;">Skid Steer (Coming Soon)</a></li>
          <li><a href="#service-area" style="color:#9CA3AF; font-size:15px;">Service Area</a></li>
          <li><a href="#contact" style="color:#9CA3AF; font-size:15px;">Contact</a></li>
        </ul>
      </div>
      <div>
        <h3 style="font-family:'Barlow Condensed',sans-serif; font-size:20px; font-weight:700; color:white; margin:0 0 16px; letter-spacing:0.04em;">Service Areas</h3>
        <ul style="list-style:none; padding:0; margin:0; display:flex; flex-direction:column; gap:8px;">
          <li style="color:#9CA3AF; font-size:15px;">Winthrop</li>
          <li style="color:#9CA3AF; font-size:15px;">Monmouth</li>
          <li style="color:#9CA3AF; font-size:15px;">Manchester</li>
          <li style="color:#9CA3AF; font-size:15px;">Readfield, Maine</li>
        </ul>
      </div>
      <div>
        <h3 style="font-family:'Barlow Condensed',sans-serif; font-size:20px; font-weight:700; color:white; margin:0 0 16px; letter-spacing:0.04em;">Contact</h3>
        <address style="font-style:normal; font-size:15px; line-height:1.8; color:#9CA3AF;">
          Winthrop, Maine<br/>
          <a href={phoneLink} style="color:#E87722; font-weight:700; font-size:20px; font-family:'Barlow Condensed',sans-serif;">{phone}</a>
        </address>
      </div>
    </div>
    <div style="border-top:1px solid #1E1E1E; padding-top:24px; display:flex; justify-content:space-between; align-items:center; flex-wrap:wrap; gap:12px;">
      <p style="margin:0; font-size:13px; color:#6B7280;">
        &copy; {year} Jaybo's Auto Repair &amp; Metal Fabrication. All rights reserved.
      </p>
      <p style="margin:0; font-size:13px; color:#6B7280;">
        Serving Winthrop &bull; Monmouth &bull; Manchester &bull; Readfield, Maine
      </p>
    </div>
  </div>
</footer>
